[Unit]
Description=ChiefOS Conversation Server (Twilio Voice WebSocket)
After=network.target

[Service]
Type=simple
# Replace COS_USER with your ChiefOS OS user (from config.env: COS_USER)
User=COS_USER
# Replace BASE_DIR with your ChiefOS workspace path (from config.env: BASE_DIR)
WorkingDirectory=BASE_DIR/scripts
ExecStart=BASE_DIR/scripts/venv_twilio/bin/python3 BASE_DIR/scripts/conversation_server.py
Restart=always
RestartSec=10
StandardOutput=append:BASE_DIR/logs/conversation_server.log
StandardError=append:BASE_DIR/logs/conversation_server.log

[Install]
WantedBy=multi-user.target
