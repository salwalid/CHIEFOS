# ChiefOS Nginx Configuration
# Generated by install.sh — do not edit manually, re-run install.sh
# Place at: /etc/nginx/sites-available/chiefos

server {
    listen 80;
    server_name CHIEFOS_DOMAIN;

    root CHIEFOS_WEBROOT;
    index index.html;

    # HQ dashboards — serve static files with no-cache headers
    location /HQ/ {
        try_files $uri $uri/ /HQ/index.html;
        add_header Cache-Control "no-cache, must-revalidate";
        add_header X-Frame-Options "SAMEORIGIN";
        add_header X-Content-Type-Options "nosniff";
    }

    # JSON data files — allow cross-origin for dashboard fetch() calls
    location ~* \.json$ {
        add_header Cache-Control "no-cache";
        add_header Access-Control-Allow-Origin "*";
    }

    # Root redirect to HQ
    location = / {
        return 301 /HQ/;
    }

    # Block dotfiles
    location ~ /\. {
        deny all;
    }

    # Block database and sensitive files
    location ~* \.(db|env|sql|log)$ {
        deny all;
    }

    access_log /var/log/nginx/chiefos-access.log;
    error_log  /var/log/nginx/chiefos-error.log;
}
