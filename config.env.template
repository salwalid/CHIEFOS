# ============================================================
# ChiefOS Configuration
# Copy this file to config.env and fill in your values.
# NEVER commit config.env — it contains your credentials.
# ============================================================

# --- Core ---
BASE_DIR=/home/youruser/chiefos       # Absolute path to ChiefOS workspace
COS_USER=youruser                     # OS user that runs ChiefOS
BASE_URL=yourdomain.com               # Your domain (no trailing slash)
DB_NAME=chiefos.db                    # SQLite database filename

# --- Timezone ---
TZ=America/New_York                   # Your timezone (used for cron offset calculation)

# --- Email monitoring (Gmail) ---
GMAIL_USER=your@gmail.com
GMAIL_PASS=your_app_password          # Use a Gmail App Password, not your real password

# --- Alerting ---
# Default: Telegram. Swap ALERT_SCRIPT for Slack/email/webhook as needed.
ALERT_SCRIPT=$BASE_DIR/scripts/utils/send_alert.sh
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# --- Owner contact (used by send_email.py CC logic) ---
OWNER_EMAIL=your@email.com
PRINCIPAL_IP=                         # Your home/office IP — used by security-login-report.py to identify your access

# --- Twilio (optional — required only if using make-call.sh) ---
TWILIO_ACCOUNT_SID=                   # Twilio Account SID
TWILIO_AUTH_TOKEN=                    # Twilio Auth Token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx       # Your Twilio phone number

# --- Angel (Governance Service) ---
ANGEL_PORT=39571                      # Port Angel's MCP server listens on
ANGEL_REPO=https://github.com/YOUR/angel-repo   # Angel's GitHub repo URL
ANGEL_MODEL=google                    # AI model for Angel: google | anthropic | openai
ANGEL_API_KEY=your_api_key            # API key for the chosen ANGEL_MODEL
