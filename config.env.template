# ============================================================
# ChiefOS Configuration
# Copy this file to config.env and fill in your values.
# NEVER commit config.env — it contains your credentials.
#
# ✅ REQUIRED     — install will fail without these
# ⚠️  RECOMMENDED  — important features depend on these
# 🔘 OPTIONAL     — leave blank to disable
# ============================================================

# --- Core (✅ REQUIRED) ---
BASE_DIR=/home/youruser/chiefos       # Absolute path where ChiefOS will be installed
COS_USER=youruser                     # OS user that runs ChiefOS (created by install.sh)
BASE_URL=yourdomain.com               # Your domain or server IP — no http://, no trailing slash
DB_NAME=chiefos.db                    # SQLite database filename

# --- Timezone (✅ REQUIRED) ---
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Examples:  America/New_York  |  America/Los_Angeles  |  Europe/London  |  Asia/Tokyo  |  UTC
TZ=America/New_York

# --- Alerting via Telegram (✅ REQUIRED) ---
# Step 1: Create a bot — message @BotFather on Telegram → /newbot → copy the token
# Step 2: Get your Chat ID — message @userinfobot on Telegram → copy the id number
ALERT_SCRIPT=$BASE_DIR/scripts/utils/send_alert.sh
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# --- Angel Governance Service (✅ REQUIRED) ---
# Angel runs as a separate OS user and approves important actions before they execute.
# She is a separate service — you need your own Angel repo URL to install.
# See docs/SETUP.md → "Before You Start" for details on setting up Angel.
ANGEL_PORT=39571                      # Port Angel's MCP server listens on (must be free)
ANGEL_REPO=https://github.com/salwalid/ANGEL     # Angel governance service repo
ANGEL_MODEL=google                    # AI model for Angel: google | anthropic | openai
ANGEL_API_KEY=your_api_key            # API key for the chosen ANGEL_MODEL

# --- Email Monitoring via Gmail (⚠️ RECOMMENDED) ---
# Enables ChiefOS to monitor your inbox and surface important emails.
# Requires a Gmail App Password — NOT your regular password.
# How to create one: https://support.google.com/accounts/answer/185833
# (You must have 2-Step Verification enabled on your Gmail account first.)
GMAIL_USER=your@gmail.com
GMAIL_PASS=your_app_password

# --- Owner Contact (⚠️ RECOMMENDED) ---
OWNER_EMAIL=your@email.com            # Your email — used for CC on outbound mail
PRINCIPAL_IP=                         # Your home/office IP — security scripts use this to identify your access vs. external threats

# --- Agent CLI (🔘 OPTIONAL) ---
# Name of your AI agent's CLI command — enables usage tracking via track_usage.py
# Example: AGENT_CLI=my-agent  Leave blank to disable.
AGENT_CLI=

# --- Twilio Voice Calls (🔘 OPTIONAL) ---
# Required only if using make-call.sh for voice alerts. Leave blank otherwise.
TWILIO_ACCOUNT_SID=                   # Twilio Account SID
TWILIO_AUTH_TOKEN=                    # Twilio Auth Token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx       # Your Twilio phone number
